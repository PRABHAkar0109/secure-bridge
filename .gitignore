# ============================================================================
# Repo-side guardrail for secure-bridge (backs up receiver/phi_scan.py).
# Raw / renderable PHI data is DENIED by default anywhere in this repo —
# EXCEPT under secure-bridge/bridge-outbox/, where only scanned, aggregated
# results are allowed to land (that folder is the only thing pushed back).
# ============================================================================

# Raw / semi-structured data (patient files, dumps, exports)
*.csv
*.xlsx
*.xlsm
*.parquet
*.feather
*.json
*.jsonl
# but security CONFIG (DLP policy) is not data — it must be version-controlled:
!secure-bridge/receiver/phi_policy.json

# Notebooks & rendered/pickled outputs silently embed PHI
*.ipynb
.ipynb_checkpoints/
*.html
*.pkl
*.joblib
*.pickle
*.pyc
__pycache__/

# Un-ignore only scanned OUTPUT: anything under bridge-outbox/ went through
# receiver/phi_scan.py before the listener is allowed to git add it.
!secure-bridge/bridge-outbox/**

# secure-bridge local-only state
secure-bridge/bridge-state/

# sender secrets
secure-bridge/sender/.env

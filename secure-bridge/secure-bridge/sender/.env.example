# SENDER ENVIRONMENT SAMPLE — copy to .env and fill in. NEVER commit a real
# token. Use a fine-grained PAT scoped read/write to this single repo, or
# better, an identity-scoped secret for the bridge process.
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_PUSH_TOKEN=ghp_REPLACE_ME   # if using HTTPS auth in push_job.sh
# SSH_REF=git@github.com:lumenbiomics/RFIs_and_Projects_Compendium.git

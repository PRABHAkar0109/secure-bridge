# SENDER ENVIRONMENT SAMPLE — copy to .env and fill in. NEVER commit the real
# .env (it is git-ignored). Use a fine-grained PAT scoped read/write to this
# single repo, or an identity-scoped secret for the bridge process.
GIT_REMOTE=origin
GIT_BRANCH=main
# GIT_PUSH_TOKEN=ghp_REPLACE_ME   # if you authenticate via HTTPS token
